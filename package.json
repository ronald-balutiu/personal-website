{
  "name": "@ronald-balutiu/website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "astro": "astro",
    "check": "astro check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test tests/e2e --config playwright.config.ts --project=chromium",
    "test:a11y": "playwright test tests/a11y --config playwright.config.ts --project=chromium",
    "test:browser": "playwright test tests/e2e tests/a11y --config playwright.config.ts --project=chromium",
    "test:cross-browser": "npm run check && npm run test:unit && playwright test tests/e2e tests/a11y --config playwright.config.ts --project=chromium --project=firefox --project=webkit",
    "test": "npm run check && npm run test:unit && npm run test:browser",
    "release:ci": "npm run astro -- sync && npm run lint:check && npm run format:check && npm run test:cross-browser",
    "release": "npm run astro -- sync && npm run lint && npm run format && npm run test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "astro": "^7.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
